        "n=[0 for i in range(101)]\n",
        "\n",
        "for i in range(1,len(n)+1):\n",
        "\n",
        "  for j in range(1,len(n),i):\n",
        "    if n[j]==0:\n",
        "      n[j]=1\n",
        "\n",
        "    else:\n",
        "      n[j]=0\n",
        "\n",
        "\n",
        "print(n.count(1))"
